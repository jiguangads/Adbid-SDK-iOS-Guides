platform :ios, '15.0'
project 'Sample.xcodeproj'
target 'Sample' do
  pod 'JAdbid/AdMob', :git => 'https://github.com/jiguangads/jadbid-ios-sdk.git', :tag => '1.0.0-beta.6'
  pod 'JAdbid/Bigo', :git => 'https://github.com/jiguangads/jadbid-ios-sdk.git', :tag => '1.0.0-beta.6'
  pod 'JAdbid/Facebook', :git => 'https://github.com/jiguangads/jadbid-ios-sdk.git', :tag => '1.0.0-beta.6'
  pod 'JAdbid/Fyber', :git => 'https://github.com/jiguangads/jadbid-ios-sdk.git', :tag => '1.0.0-beta.6'
  pod 'JAdbid/InMobi', :git => 'https://github.com/jiguangads/jadbid-ios-sdk.git', :tag => '1.0.0-beta.6'
  pod 'JAdbid/IronSource', :git => 'https://github.com/jiguangads/jadbid-ios-sdk.git', :tag => '1.0.0-beta.6'
  pod 'JAdbid/Mintegral', :git => 'https://github.com/jiguangads/jadbid-ios-sdk.git', :tag => '1.0.0-beta.6'
  pod 'JAdbid/Pangle', :git => 'https://github.com/jiguangads/jadbid-ios-sdk.git', :tag => '1.0.0-beta.6'
  pod 'JAdbid/Unity', :git => 'https://github.com/jiguangads/jadbid-ios-sdk.git', :tag => '1.0.0-beta.6'
  pod 'JAdbid/Vungle', :git => 'https://github.com/jiguangads/jadbid-ios-sdk.git', :tag => '1.0.0-beta.6'
  pod 'JAdbid/Yandex', :git => 'https://github.com/jiguangads/jadbid-ios-sdk.git', :tag => '1.0.0-beta.6'
end
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'
    end
  end
end
